# Include your custom HAL commands here
# This file will not be overwritten when you run PNCconf again

loadrt not count=3
loadrt limit1 count=1

addf not.0 servo-thread
addf not.1 servo-thread
addf not.2 servo-thread
addf limit1.0 servo-thread

loadusr -Wn svd-ps_vfd svd-ps_vfd -S [SPINDLE]MAX_RPM -F [SPINDLE]MAX_FREQ -f 5 -d /dev/ttyUSB0 

net spindle-vel-cmd-rpm => limit1.0.in
net spindle-vel-cmd-rpm-limited <= limit1.0.out

net spindle-vel-cmd-rpm-limited => svd-ps_vfd.speed-cmd
net spindle-enable => svd-ps_vfd.spindle-on

loadusr -W rp2040_encoder

setp rp2040-encoder.0.scale-0 -0.005
setp rp2040-encoder.0.scale-1  0.005
setp rp2040-encoder.0.scale-2  0.005

unlinkp hm2_7i76e.0.stepgen.00.position-fb
unlinkp hm2_7i76e.0.stepgen.01.position-fb
unlinkp hm2_7i76e.0.stepgen.02.position-fb

net x-pos-fb <= rp2040-encoder.0.position-0
net y-pos-fb <= rp2040-encoder.0.position-1
net z-pos-fb <= rp2040-encoder.0.position-2

#loadusr halcmd setp rp2040-encoder.0.reset-0 0
#loadusr halcmd setp rp2040-encoder.0.reset-0 1
#loadusr halcmd setp rp2040-encoder.0.reset-1 0
#loadusr halcmd setp rp2040-encoder.0.reset-1 1
#loadusr halcmd setp rp2040-encoder.0.reset-2 0
#loadusr halcmd setp rp2040-encoder.0.reset-2 1
